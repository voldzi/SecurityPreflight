APP_ENV=development
APP_PORT=8781
WEB_PORT=8780
DATABASE_URL=postgresql://security_preflight:security_preflight@postgres:5432/security_preflight
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=info
REPORTS_PATH=/reports
PROJECTS_ROOT_HOST=/absolute/path/to/projects
PROJECTS_ROOT_CONTAINER=/workspace/projects
SCANNER_NETWORK_MODE=none
ALLOW_DOCKER_SOCKET=false
ALLOW_ACTIVE_DAST=false
DAST_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal
OTEL_EXPORTER_OTLP_ENDPOINT=
