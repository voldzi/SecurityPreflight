SECURITY_PREFLIGHT_DEFECTDOJO_PRODUCT=
SECURITY_PREFLIGHT_DEFECTDOJO_EXPORT_ENABLED=false
SECURITY_PREFLIGHT_DEFECTDOJO_EXPORT_REQUIRED=false
SECURITY_PREFLIGHT_DEFECTDOJO_REIMPORT=false
SECURITY_PREFLIGHT_DEFECTDOJO_PRODUCT_TYPE=STRATOS
SECURITY_PREFLIGHT_DEFECTDOJO_ENGAGEMENT=
SECURITY_PREFLIGHT_DEFECTDOJO_AUTO_CREATE_CONTEXT=true
SECURITY_PREFLIGHT_GREENBONE_URL=
