SECURITY_PREFLIGHT_EXTERNAL_SCANNER_PUBLIC_KEY=
SECURITY_PREFLIGHT_EXTERNAL_SCANNER_REQUIRE_SIGNATURE=true
SECURITY_PREFLIGHT_DEFECTDOJO_URL=
