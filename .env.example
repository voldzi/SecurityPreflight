APP_ENV=development
APP_PORT=8781
WEB_PORT=8780
NEXT_PUBLIC_API_URL=http://localhost:8781
NEXT_PUBLIC_SECURITY_PREFLIGHT_BASE_PATH=
NEXT_PUBLIC_SECURITY_PREFLIGHT_PUBLIC_BASE_URL=http://localhost:8780
NEXT_PUBLIC_SECURITY_PREFLIGHT_OIDC_ISSUER=https://login.zeleznalady.cz/realms/stratos
NEXT_PUBLIC_SECURITY_PREFLIGHT_OIDC_CLIENT_ID=security-preflight-web
NEXT_PUBLIC_SECURITY_PREFLIGHT_OIDC_SCOPES=openid profile email
NEXT_PUBLIC_STRATOS_HOME_URL=https://stratos.zeleznalady.cz/
NEXT_PUBLIC_PROJECTFLOW_URL=https://stratos.zeleznalady.cz/project
NEXT_PUBLIC_AKB_URL=https://stratos.zeleznalady.cz/akb
NEXT_PUBLIC_ARCHFLOW_URL=
NEXT_PUBLIC_PROCESSFORGE_URL=
DATABASE_URL=postgresql://security_preflight:security_preflight@postgres:5432/security_preflight
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=info
REPORTS_PATH=/reports
PROJECTS_ROOT_HOST=/absolute/path/to/projects
PROJECTS_ROOT_CONTAINER=/workspace/projects
SECURITY_PREFLIGHT_AUTH_MODE=
SECURITY_PREFLIGHT_API_TOKEN=
SECURITY_PREFLIGHT_CORS_ORIGINS=http://localhost:8780,http://127.0.0.1:8780
SECURITY_PREFLIGHT_OIDC_ISSUER=https://login.zeleznalady.cz/realms/stratos
SECURITY_PREFLIGHT_OIDC_JWKS_URL=https://login.zeleznalady.cz/realms/stratos/protocol/openid-connect/certs
SECURITY_PREFLIGHT_OIDC_CLIENT_ID=security-preflight-web
SECURITY_PREFLIGHT_OIDC_AUDIENCE=security-preflight-web
SECURITY_PREFLIGHT_REQUIRED_ROLES=security-preflight.viewer,security-preflight.operator,security-preflight.admin,stratos_security_admin,stratos_superadmin,superadmin
SECURITY_PREFLIGHT_OPERATOR_ROLES=security-preflight.operator,security-preflight.admin,stratos_security_admin,stratos_superadmin,superadmin
SCANNER_NETWORK_MODE=none
SCANNER_RUNNER_ENABLED=true
SCANNER_RUNNER_MODE=direct
SCANNER_TOOLBOX_IMAGE=security-preflight/scanner-toolbox:local
ALLOW_DOCKER_SOCKET=false
ALLOW_ACTIVE_DAST=false
DAST_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal
SECURITY_PREFLIGHT_AKB_RAG_BASE_URL=
SECURITY_PREFLIGHT_AKB_PUBLIC_BASE_URL=https://stratos.zeleznalady.cz/akb
SECURITY_PREFLIGHT_AKB_SERVICE_TOKEN=
SECURITY_PREFLIGHT_AKB_OIDC_TOKEN_URL=
SECURITY_PREFLIGHT_AKB_OIDC_CLIENT_ID=
SECURITY_PREFLIGHT_AKB_OIDC_CLIENT_SECRET=
SECURITY_PREFLIGHT_AKB_OIDC_AUDIENCE=akl-api
SECURITY_PREFLIGHT_AKB_OIDC_SCOPE=openid profile email
SECURITY_PREFLIGHT_AKB_SYNC_REQUIRED=false
SECURITY_PREFLIGHT_TENANT_ID=default
OTEL_EXPORTER_OTLP_ENDPOINT=
