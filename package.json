{
  "name": "security-preflight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @security-preflight/api dev",
    "dev:web": "pnpm --filter @security-preflight/web dev",
    "dev:worker": "pnpm --filter @security-preflight/worker dev",
    "lint:openapi": "redocly lint openapi/openapi.json",
    "reset:epoch": "bash scripts/reset-owner-epoch.sh",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "validate": "bash scripts/validate-skeleton.sh && pnpm typecheck && pnpm test && pnpm build && pnpm lint:openapi"
  },
  "devDependencies": {
    "@redocly/cli": "^1.34.5",
    "@types/node": "^26.0.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.2"
  }
}
