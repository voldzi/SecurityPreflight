# syntax=docker/dockerfile:1.7
FROM node:26-bookworm-slim

WORKDIR /app
RUN npm install -g pnpm@10.33.0
ARG NEXT_PUBLIC_API_URL=http://localhost:8781
ARG NEXT_PUBLIC_SECURITY_PREFLIGHT_BASE_PATH=
ARG NEXT_PUBLIC_SECURITY_PREFLIGHT_PUBLIC_BASE_URL=
ARG NEXT_PUBLIC_SECURITY_PREFLIGHT_OIDC_ISSUER=
ARG NEXT_PUBLIC_SECURITY_PREFLIGHT_OIDC_CLIENT_ID=
ARG NEXT_PUBLIC_SECURITY_PREFLIGHT_OIDC_SCOPES=openid profile email
ARG NEXT_PUBLIC_STRATOS_HOME_URL=https://stratos.zeleznalady.cz/
ARG NEXT_PUBLIC_PROJECTFLOW_URL=https://stratos.zeleznalady.cz/project
ARG NEXT_PUBLIC_AKB_URL=https://stratos.zeleznalady.cz/akb
ARG NEXT_PUBLIC_ARCHFLOW_URL=
ARG NEXT_PUBLIC_PROCESSFORGE_URL=
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_SECURITY_PREFLIGHT_BASE_PATH=${NEXT_PUBLIC_SECURITY_PREFLIGHT_BASE_PATH}
ENV NEXT_PUBLIC_SECURITY_PREFLIGHT_PUBLIC_BASE_URL=${NEXT_PUBLIC_SECURITY_PREFLIGHT_PUBLIC_BASE_URL}
ENV NEXT_PUBLIC_SECURITY_PREFLIGHT_OIDC_ISSUER=${NEXT_PUBLIC_SECURITY_PREFLIGHT_OIDC_ISSUER}
ENV NEXT_PUBLIC_SECURITY_PREFLIGHT_OIDC_CLIENT_ID=${NEXT_PUBLIC_SECURITY_PREFLIGHT_OIDC_CLIENT_ID}
ENV NEXT_PUBLIC_SECURITY_PREFLIGHT_OIDC_SCOPES=${NEXT_PUBLIC_SECURITY_PREFLIGHT_OIDC_SCOPES}
ENV NEXT_PUBLIC_STRATOS_HOME_URL=${NEXT_PUBLIC_STRATOS_HOME_URL}
ENV NEXT_PUBLIC_PROJECTFLOW_URL=${NEXT_PUBLIC_PROJECTFLOW_URL}
ENV NEXT_PUBLIC_AKB_URL=${NEXT_PUBLIC_AKB_URL}
ENV NEXT_PUBLIC_ARCHFLOW_URL=${NEXT_PUBLIC_ARCHFLOW_URL}
ENV NEXT_PUBLIC_PROCESSFORGE_URL=${NEXT_PUBLIC_PROCESSFORGE_URL}
ENV NODE_ENV=production

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json .npmrc ./
COPY apps/web/package.json apps/web/package.json
COPY packages/core/package.json packages/core/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/persistence/package.json packages/persistence/package.json
COPY packages/report/package.json packages/report/package.json
COPY packages/scanners/package.json packages/scanners/package.json

RUN --mount=type=secret,id=npmrc,target=/root/.npmrc,required=false pnpm install --frozen-lockfile

COPY . .
RUN pnpm --filter @security-preflight/web build

EXPOSE 8780
CMD ["pnpm", "--filter", "@security-preflight/web", "start"]
