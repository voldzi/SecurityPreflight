{
  "name": "@security-preflight/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --clear-screen=false --exclude ../../node_modules --exclude ../../dist src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@security-preflight/core": "workspace:*",
    "@security-preflight/persistence": "workspace:*",
    "@security-preflight/report": "workspace:*",
    "@security-preflight/scanners": "workspace:*",
    "bullmq": "^5.79.2",
    "ioredis": "^5.6.1"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^3.2.2"
  }
}
