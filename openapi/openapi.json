{
  "openapi": "3.1.0",
  "info": {
    "title": "SecurityPreflight API",
    "version": "1.0.0",
    "description": "Machine-readable OpenAPI specification for this service.",
    "license": {
      "name": "Proprietary",
      "identifier": "LicenseRef-Proprietary"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8781",
      "description": "Local Docker Desktop API server"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "operationId": "getHealth",
        "tags": ["System"],
        "security": [],
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid health check request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "summary": "Readiness check",
        "operationId": "getReadiness",
        "tags": ["System"],
        "security": [],
        "responses": {
          "200": {
            "description": "Service is ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid readiness check request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service is not ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects": {
      "get": {
        "summary": "List registered projects",
        "operationId": "listProjects",
        "tags": ["Projects"],
        "security": [],
        "responses": {
          "200": {
            "description": "Registered projects",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid projects request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/scan-profiles": {
      "get": {
        "summary": "List built-in scan profiles",
        "operationId": "listScanProfiles",
        "tags": ["Scans"],
        "security": [],
        "responses": {
          "200": {
            "description": "Available scan profiles",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanProfileListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid scan profile request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/scans/plan": {
      "post": {
        "summary": "Build a guarded scan execution plan without running scanners",
        "operationId": "createScanExecutionPlan",
        "tags": ["Scans"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScanPlanRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Execution plan. Guardrail failures are represented by blocked=true and blockedReasons.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanExecutionPlan"
                }
              }
            }
          },
          "400": {
            "description": "Invalid scan plan request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Requested scan profile was not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/scans/queue": {
      "post": {
        "summary": "Queue an unblocked scan execution plan",
        "operationId": "queueScanExecution",
        "tags": ["Scans"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScanPlanRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Scan plan accepted and queued for worker execution",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanQueueResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid scan queue request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Requested scan profile was not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Scan plan is blocked by guardrails and cannot be queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/scans/runs": {
      "get": {
        "summary": "List scan runs with local report evidence",
        "operationId": "listScanRuns",
        "tags": ["Scans"],
        "security": [],
        "responses": {
          "200": {
            "description": "Scan runs discovered under the configured reports path",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanRunListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid scan run list request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/scans/runs/{scanRunId}": {
      "get": {
        "summary": "Get scan run detail and redacted evidence manifest",
        "operationId": "getScanRunDetail",
        "tags": ["Scans"],
        "security": [],
        "parameters": [
          {
            "name": "scanRunId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]+$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Scan run detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanRunDetailResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid scan run ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Scan run evidence was not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/scans/runs/{scanRunId}/report": {
      "get": {
        "summary": "Get a redacted scan report artifact",
        "operationId": "getScanRunReport",
        "tags": ["Scans"],
        "security": [],
        "parameters": [
          {
            "name": "scanRunId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]+$"
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["markdown", "json"],
              "default": "markdown"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Report content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanRunReportResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid scan report request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Scan report evidence was not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/toolchain/doctor": {
      "get": {
        "summary": "Check local scanner and runtime tool availability",
        "operationId": "getToolchainDoctor",
        "tags": ["Toolchain"],
        "security": [],
        "responses": {
          "200": {
            "description": "Toolchain diagnostic result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolchainDoctorResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid toolchain doctor request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/toolchain/requirements": {
      "get": {
        "summary": "List required scanner and evidence tooling",
        "operationId": "listToolchainRequirements",
        "tags": ["Toolchain"],
        "security": [],
        "responses": {
          "200": {
            "description": "Required scanner and evidence tooling",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolRequirementListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid toolchain requirements request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/results/ingest": {
      "post": {
        "summary": "Accept a redacted SecurityPreflight result envelope for central storage",
        "operationId": "ingestResultEnvelope",
        "tags": ["Results"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CentralResultEnvelope"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Result envelope accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultIngestResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid result envelope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": ["status", "service", "version", "timestamp"],
        "properties": {
          "status": {
            "type": "string",
            "examples": ["ok"]
          },
          "service": {
            "type": "string",
            "examples": ["security-preflight"]
          },
          "version": {
            "type": "string",
            "examples": ["1.0.0"]
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Project": {
        "type": "object",
        "required": [
          "id",
          "name",
          "path",
          "repositoryUrl",
          "defaultBranch",
          "technologyStack",
          "dataClassification",
          "owner",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "description": "Absolute host path to the project directory."
          },
          "repositoryUrl": {
            "type": ["string", "null"]
          },
          "defaultBranch": {
            "type": ["string", "null"]
          },
          "technologyStack": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dataClassification": {
            "type": "string",
            "enum": ["public", "internal", "confidential", "sensitive", "health-data"]
          },
          "owner": {
            "type": ["string", "null"]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ProjectListResponse": {
        "type": "object",
        "required": ["data", "meta"],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Project"
            }
          },
          "meta": {
            "type": "object",
            "required": ["total"],
            "properties": {
              "total": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      },
      "ScanProfile": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "checks",
          "failThreshold",
          "allowActiveDast",
          "allowProductionTargets",
          "timeoutSeconds"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "failThreshold": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "allowActiveDast": {
            "type": "boolean"
          },
          "allowProductionTargets": {
            "type": "boolean"
          },
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "ScanProfileListResponse": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScanProfile"
            }
          }
        }
      },
      "ScanPlanRequest": {
        "type": "object",
        "required": ["project"],
        "properties": {
          "scanRunId": {
            "type": "string"
          },
          "profileId": {
            "type": "string",
            "default": "fast-local"
          },
          "reportsRoot": {
            "type": "string",
            "default": "/reports"
          },
          "project": {
            "$ref": "#/components/schemas/ScanPlanProject"
          },
          "dast": {
            "$ref": "#/components/schemas/DastPolicyRequest"
          }
        }
      },
      "ScanPlanProject": {
        "type": "object",
        "required": ["id", "name", "path"],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "description": "Absolute host path to the project directory."
          },
          "dataClassification": {
            "type": "string",
            "enum": ["public", "internal", "confidential", "sensitive", "health-data"],
            "default": "internal"
          }
        }
      },
      "DastPolicyRequest": {
        "type": "object",
        "properties": {
          "targetUrl": {
            "type": "string",
            "format": "uri"
          },
          "allowedHosts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": ["localhost", "127.0.0.1", "host.docker.internal"]
          },
          "excludedPaths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allowActiveScan": {
            "type": "boolean",
            "default": false
          },
          "allowProductionTargets": {
            "type": "boolean",
            "default": false
          },
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "ScanExecutionPlan": {
        "type": "object",
        "required": [
          "id",
          "scanRunId",
          "createdAt",
          "project",
          "profile",
          "blocked",
          "blockedReasons",
          "evidenceRoot",
          "policy",
          "steps"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "scanRunId": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "project": {
            "$ref": "#/components/schemas/ScanPlanProject"
          },
          "profile": {
            "$ref": "#/components/schemas/ScanExecutionPlanProfile"
          },
          "blocked": {
            "type": "boolean"
          },
          "blockedReasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidenceRoot": {
            "type": "string"
          },
          "policy": {
            "$ref": "#/components/schemas/ScanPlanPolicy"
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScanExecutionStep"
            }
          }
        }
      },
      "ScanExecutionPlanProfile": {
        "type": "object",
        "required": ["id", "name", "failThreshold", "timeoutSeconds", "allowActiveDast", "allowProductionTargets"],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "failThreshold": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 1
          },
          "allowActiveDast": {
            "type": "boolean"
          },
          "allowProductionTargets": {
            "type": "boolean"
          }
        }
      },
      "ScanQueueResponse": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/QueuedScan"
          }
        }
      },
      "QueuedScan": {
        "type": "object",
        "required": ["jobId", "scanRunId", "status", "plan"],
        "properties": {
          "jobId": {
            "type": "string"
          },
          "scanRunId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["queued"]
          },
          "plan": {
            "$ref": "#/components/schemas/ScanExecutionPlan"
          }
        }
      },
      "ScanPlanPolicy": {
        "type": "object",
        "required": ["defaultNetworkMode", "allowedDastHosts", "activeDastTarget"],
        "properties": {
          "defaultNetworkMode": {
            "type": "string",
            "enum": ["disabled", "restricted"]
          },
          "allowedDastHosts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "activeDastTarget": {
            "type": ["string", "null"],
            "format": "uri"
          }
        }
      },
      "ScanExecutionStep": {
        "type": "object",
        "required": [
          "id",
          "checkId",
          "tool",
          "type",
          "status",
          "executionMode",
          "command",
          "timeoutSeconds",
          "networkMode",
          "evidencePaths",
          "projectMount",
          "guardrails",
          "blockedReasons"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "checkId": {
            "type": "string"
          },
          "tool": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "sast",
              "sca",
              "secret",
              "container",
              "iac",
              "dast",
              "openapi",
              "documentation",
              "configuration",
              "tooling"
            ]
          },
          "status": {
            "type": "string",
            "enum": ["planned", "blocked"]
          },
          "executionMode": {
            "type": "string",
            "enum": ["container", "internal"]
          },
          "command": {
            "type": ["array", "null"],
            "items": {
              "type": "string"
            }
          },
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 1
          },
          "networkMode": {
            "type": "string",
            "enum": ["disabled", "restricted"]
          },
          "evidencePaths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "projectMount": {
            "$ref": "#/components/schemas/ScanProjectMount"
          },
          "guardrails": {
            "$ref": "#/components/schemas/ScanStepGuardrails"
          },
          "blockedReasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ScanProjectMount": {
        "type": "object",
        "required": ["sourcePath", "targetPath", "readOnly"],
        "properties": {
          "sourcePath": {
            "type": "string"
          },
          "targetPath": {
            "type": "string"
          },
          "readOnly": {
            "type": "boolean"
          }
        }
      },
      "ScanStepGuardrails": {
        "type": "object",
        "required": ["dropCapabilities", "privileged", "dockerSocket", "activeDast"],
        "properties": {
          "dropCapabilities": {
            "type": "boolean"
          },
          "privileged": {
            "type": "boolean"
          },
          "dockerSocket": {
            "type": "boolean"
          },
          "activeDast": {
            "type": "boolean"
          }
        }
      },
      "ScanRunListResponse": {
        "type": "object",
        "required": ["data", "meta"],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScanRunSummary"
            }
          },
          "meta": {
            "type": "object",
            "required": ["total", "reportsPath"],
            "properties": {
              "total": {
                "type": "integer",
                "minimum": 0
              },
              "reportsPath": {
                "type": "string"
              }
            }
          }
        }
      },
      "ScanRunDetailResponse": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ScanRunDetail"
          }
        }
      },
      "ScanRunReportResponse": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": {
            "type": "object",
            "required": ["scanRunId", "format", "fileName", "contentType", "content"],
            "properties": {
              "scanRunId": {
                "type": "string"
              },
              "format": {
                "type": "string",
                "enum": ["markdown", "json"]
              },
              "fileName": {
                "type": "string"
              },
              "contentType": {
                "type": "string"
              },
              "content": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "additionalProperties": true
                  }
                ]
              }
            }
          }
        }
      },
      "ScanRunSummary": {
        "type": "object",
        "required": [
          "id",
          "status",
          "gateResult",
          "project",
          "profile",
          "startedAt",
          "finishedAt",
